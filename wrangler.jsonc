{
  // Cloudflare Worker config for Bookends. "name" must match the Worker's name in the Cloudflare dashboard.
  "name": "bookends",
  "compatibility_date": "2026-11-24",
  "assets": {
    "directory": ".",
    // Show 404.html (with a 404 status) for addresses that don't match a file
    "not_found_handling": "404-page"
  }
}
